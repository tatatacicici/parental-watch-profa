<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.parental_watch"
    xmlns:tools="http://schemas.android.com/tools">
    <!--For Overlay    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!--For Accesibility Service    -->
    <uses-permission android:name="android.permission.BIND_ACCESSIBILITY_SERVICE"
        tools:ignore="ProtectedPermissions"/>

    <!--For Device Admin    -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--For internet    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Parentalwatch">
        <!-- Halaman utama -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Parentalwatch">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".PinSetupActivity" android:exported="false" />
        <activity android:name=".ParentLoginActivity" android:exported="false" />
        <activity android:name=".ParentDashboardActivity" android:exported="false" />
        <activity android:name=".ChildModeActivity" android:exported="false" />

        <!-- Accessibility Service — akan diisi Minggu 3 -->
        <!--
        <service
            android:name=".service.MonitoringService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service" />
        </service>
        -->
    </application>

</manifest>